        <mxCell id="2De_PH" value="&lt;b&gt;Arize Phoenix&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px&#39;&gt;traces, latency and cost&lt;/font&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px&#39;&gt;for every single step&lt;/font&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#EEEEEE;strokeColor=#6F6F6F;fontColor=#242424;strokeWidth=2;align=center;verticalAlign=middle;fontSize=14;" vertex="1" parent="1">
