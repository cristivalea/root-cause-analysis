        </mxCell>
        <mxCell id="2De_FA" value="&lt;b&gt;FastAPI&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;REST / JSON  ·  checks the JWT token, reads the role from SQLite  ·  starts each run as a background task&lt;/font&gt; 🔒" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FDF0E3;strokeColor=#C97614;fontColor=#5A3208;strokeWidth=2;align=center;verticalAlign=middle;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="480" y="326" width="1180" height="74" as="geometry" />
        </mxCell>
        <mxCell id="2De_OR" value="&lt;b&gt;RCA Orchestrator  (LangGraph graph)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;Builds the context of the problem by code, then runs the nodes in order and passes the state between them. It never reasons about the problem itself.&lt;/font&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#E7F6EC;strokeColor=#3F9D5B;fontColor=#12401F;strokeWidth=2;align=center;verticalAlign=middle;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="480" y="486" width="1180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="2De_A1" value="①  &lt;b&gt;Investigation Planner&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;Writes the search queries; may ask for extra searches, checked by code.&lt;/font&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#F3EAFC;strokeColor=#8B54C6;fontColor=#3B1A5E;strokeWidth=2;align=center;verticalAlign=middle;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="530" y="700" width="620" height="74" as="geometry" />
        </mxCell>
        <mxCell id="2De_T1" value="②  &lt;b&gt;CMDB lookup&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;Which components the services have, and what they depend on.&lt;/font&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#E7F6EC;strokeColor=#3F9D5B;fontColor=#12401F;strokeWidth=2;align=center;verticalAlign=middle;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="530" y="810" width="620" height="74" as="geometry" />
        </mxCell>
        <mxCell id="2De_T2" value="②  &lt;b&gt;Change lookup&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;Changes from 7 days before the first incident to the last resolution.&lt;/font&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#E7F6EC;strokeColor=#3F9D5B;fontColor=#12401F;strokeWidth=2;align=center;verticalAlign=middle;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="530" y="900" width="620" height="74" as="geometry" />
        </mxCell>
        <mxCell id="2De_T3" value="②  &lt;b&gt;Log lookup  ·  similar incidents&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;Logs around every incident; past incidents with the same symptoms.&lt;/font&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#E7F6EC;strokeColor=#3F9D5B;fontColor=#12401F;strokeWidth=2;align=center;verticalAlign=middle;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="530" y="990" width="620" height="74" as="geometry" />
        </mxCell>
        <mxCell id="2De_A2" value="③  &lt;b&gt;Historical Review Agent&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;Keeps the past RCAs and incidents of the same service that really match.&lt;/font&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#F3EAFC;strokeColor=#8B54C6;fontColor=#3B1A5E;strokeWidth=2;align=center;verticalAlign=middle;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="530" y="1100" width="620" height="74" as="geometry" />
        </mxCell>
        <mxCell id="2De_T4" value="④  &lt;b&gt;Evidence Ledger  ·  timeline&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;Every fact with an id, its source and its time, then put in time order.&lt;/font&gt;" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;size=0.03;fillColor=#E7F6EC;strokeColor=#3F9D5B;fontColor=#12401F;strokeWidth=2;align=center;verticalAlign=middle;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="530" y="1210" width="620" height="74" as="geometry" />
        </mxCell>
        <mxCell id="2De_A3" value="⑤  &lt;b&gt;RCA Reasoning Agent&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;Reads only the ledger and proposes candidate root causes.&lt;/font&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#F3EAFC;strokeColor=#8B54C6;fontColor=#3B1A5E;strokeWidth=2;align=center;verticalAlign=middle;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="530" y="1320" width="620" height="74" as="geometry" />
        </mxCell>
        <mxCell id="2De_GR" value="⑥  &lt;b&gt;Guardrail  ·  confidence&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;Checks the answer, asks again up to 3 times; code rates HIGH / MEDIUM / LOW.&lt;/font&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#E7F6EC;strokeColor=#3F9D5B;fontColor=#12401F;strokeWidth=2;align=center;verticalAlign=middle;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="530" y="1430" width="620" height="74" as="geometry" />
        </mxCell>
        <mxCell id="2De_T5" value="⑦  &lt;b&gt;Save revision&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;Saves the revision: a draft, manual review, or failed, with its steps.&lt;/font&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#E7F6EC;strokeColor=#3F9D5B;fontColor=#12401F;strokeWidth=2;align=center;verticalAlign=middle;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="530" y="1540" width="620" height="74" as="geometry" />
        </mxCell>
        <mxCell id="2De_DB" value="&lt;b&gt;SQLite&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;incidents  ·  CMDB  ·  changes&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;problems  ·  RCAs  ·  revisions&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;status history  ·  users&lt;/font&gt; 🔒" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=13;whiteSpace=wrap;html=1;fillColor=#FFF7DC;strokeColor=#B8930F;fontColor=#4A3A05;strokeWidth=2;align=center;verticalAlign=middle;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1330" y="780" width="360" height="180" as="geometry" />
        </mxCell>
        <mxCell id="2De_LG" value="&lt;b&gt;Logs&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;log lines, a table of the same SQLite file&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=13;whiteSpace=wrap;html=1;fillColor=#FFF7DC;strokeColor=#B8930F;fontColor=#4A3A05;strokeWidth=2;align=center;verticalAlign=middle;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1330" y="990" width="360" height="96" as="geometry" />
        </mxCell>
        <mxCell id="2De_CH" value="&lt;b&gt;ChromaDB&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;vector index of past incidents&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;and sections of past RCAs&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=13;whiteSpace=wrap;html=1;fillColor=#FFF7DC;strokeColor=#B8930F;fontColor=#4A3A05;strokeWidth=2;align=center;verticalAlign=middle;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1330" y="1112" width="360" height="140" as="geometry" />
        </mxCell>
        <mxCell id="2De_LLM" value="&lt;b&gt;Groq API&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;gpt-oss-120b, open-weight model&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;fallback models optional&lt;/font&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#EEEEEE;strokeColor=#6F6F6F;fontColor=#242424;strokeWidth=2;align=center;verticalAlign=middle;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="85" y="1300" width="290" height="120" as="geometry" />
        </mxCell>
        <mxCell id="2De_PH" value="&lt;b&gt;Arize Phoenix&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;traces of every run, tool&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;and model call&lt;/font&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#EEEEEE;strokeColor=#6F6F6F;fontColor=#242424;strokeWidth=2;align=center;verticalAlign=middle;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="85" y="1500" width="290" height="120" as="geometry" />
        </mxCell>
        <mxCell id="2De_EMB" value="&lt;b&gt;Ollama&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;nomic-embed-text&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;runs on the same host&lt;/font&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#EEEEEE;strokeColor=#6F6F6F;fontColor=#242424;strokeWidth=2;align=center;verticalAlign=middle;fontSize=14;" vertex="1" parent="1">
