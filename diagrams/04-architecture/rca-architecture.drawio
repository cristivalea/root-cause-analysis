          <mxGeometry x="480" y="326" width="1180" height="74" as="geometry" />
        </mxCell>
        <mxCell id="2De_OR" value="&lt;b&gt;RCA Orchestrator  (state machine)&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px&#39;&gt;Decides which step runs next and passes data between steps. It never reasons about the incident itself.&lt;/font&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#E7F6EC;strokeColor=#3F9D5B;fontColor=#12401F;strokeWidth=2;align=center;verticalAlign=middle;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="480" y="486" width="1180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="2De_A1" value="①  &lt;b&gt;Investigation Planner&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px&#39;&gt;Turns the incident into a checklist of what to look at.&lt;/font&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#F3EAFC;strokeColor=#8B54C6;fontColor=#3B1A5E;strokeWidth=2;align=center;verticalAlign=middle;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="530" y="700" width="620" height="74" as="geometry" />
        </mxCell>
        <mxCell id="2De_T1" value="②  &lt;b&gt;CMDB lookup&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px&#39;&gt;Which services, hosts and dependencies are involved?&lt;/font&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#E7F6EC;strokeColor=#3F9D5B;fontColor=#12401F;strokeWidth=2;align=center;verticalAlign=middle;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="530" y="810" width="620" height="74" as="geometry" />
        </mxCell>
        <mxCell id="2De_T2" value="②  &lt;b&gt;Change lookup&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px&#39;&gt;What was deployed or changed near those components?&lt;/font&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#E7F6EC;strokeColor=#3F9D5B;fontColor=#12401F;strokeWidth=2;align=center;verticalAlign=middle;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="530" y="900" width="620" height="74" as="geometry" />
        </mxCell>
        <mxCell id="2De_T3" value="②  &lt;b&gt;Log lookup&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px&#39;&gt;Pulls the log lines for the incident time window.&lt;/font&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#E7F6EC;strokeColor=#3F9D5B;fontColor=#12401F;strokeWidth=2;align=center;verticalAlign=middle;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="530" y="990" width="620" height="74" as="geometry" />
        </mxCell>
        <mxCell id="2De_A2" value="③  &lt;b&gt;Historical RCA Agent&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px&#39;&gt;Finds past incidents and past RCAs that look like this one.&lt;/font&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#F3EAFC;strokeColor=#8B54C6;fontColor=#3B1A5E;strokeWidth=2;align=center;verticalAlign=middle;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="530" y="1100" width="620" height="74" as="geometry" />
        </mxCell>
        <mxCell id="2De_T4" value="④  &lt;b&gt;Evidence Ledger&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px&#39;&gt;Append-only: every finding is stored with its source.&lt;/font&gt;" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;size=0.03;fillColor=#E7F6EC;strokeColor=#3F9D5B;fontColor=#12401F;strokeWidth=2;align=center;verticalAlign=middle;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="530" y="1210" width="620" height="74" as="geometry" />
        </mxCell>
        <mxCell id="2De_A3" value="⑤  &lt;b&gt;RCA Reasoning Agent&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px&#39;&gt;Reads the whole evidence bundle and proposes a root cause.&lt;/font&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#F3EAFC;strokeColor=#8B54C6;fontColor=#3B1A5E;strokeWidth=2;align=center;verticalAlign=middle;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="530" y="1320" width="620" height="74" as="geometry" />
        </mxCell>
        <mxCell id="2De_GR" value="⑥  &lt;b&gt;Guardrails and Validation&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px&#39;&gt;Schema, policy and evidence checks. Nothing is stored until it passes.&lt;/font&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#E7F6EC;strokeColor=#3F9D5B;fontColor=#12401F;strokeWidth=2;align=center;verticalAlign=middle;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="530" y="1430" width="620" height="74" as="geometry" />
        </mxCell>
        <mxCell id="2De_T5" value="⑦  &lt;b&gt;RCA Record Store&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px&#39;&gt;Writes the approved RCA plus its audit trail.&lt;/font&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#E7F6EC;strokeColor=#3F9D5B;fontColor=#12401F;strokeWidth=2;align=center;verticalAlign=middle;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="530" y="1540" width="620" height="74" as="geometry" />
        </mxCell>
        <mxCell id="2De_DB" value="&lt;b&gt;SQLite&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px&#39;&gt;incidents  ·  CMDB  ·  changes&lt;/font&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px&#39;&gt;RCA records  ·  audit log&lt;/font&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px&#39;&gt;local file, encrypted at rest&lt;/font&gt; 🔒" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=13;whiteSpace=wrap;html=1;fillColor=#FFF7DC;strokeColor=#B8930F;fontColor=#4A3A05;strokeWidth=2;align=center;verticalAlign=middle;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1330" y="780" width="360" height="180" as="geometry" />
        </mxCell>
        <mxCell id="2De_LG" value="&lt;b&gt;Log store&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px&#39;&gt;raw application and system logs&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=13;whiteSpace=wrap;html=1;fillColor=#FFF7DC;strokeColor=#B8930F;fontColor=#4A3A05;strokeWidth=2;align=center;verticalAlign=middle;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1330" y="990" width="360" height="96" as="geometry" />
        </mxCell>
        <mxCell id="2De_CH" value="&lt;b&gt;ChromaDB&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px&#39;&gt;vector index of past incidents&lt;/font&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px&#39;&gt;and past RCAs&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=13;whiteSpace=wrap;html=1;fillColor=#FFF7DC;strokeColor=#B8930F;fontColor=#4A3A05;strokeWidth=2;align=center;verticalAlign=middle;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1330" y="1112" width="360" height="140" as="geometry" />
        </mxCell>
        <mxCell id="2De_LLM" value="&lt;b&gt;Groq API&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px&#39;&gt;open-source LLM&lt;/font&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px&#39;&gt;only outbound internet call&lt;/font&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#EEEEEE;strokeColor=#6F6F6F;fontColor=#242424;strokeWidth=2;align=center;verticalAlign=middle;fontSize=14;" vertex="1" parent="1">
