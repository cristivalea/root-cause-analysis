# Copy this file to .env and fill in your own values. Never commit .env.

# Groq API key, from https://console.groq.com/keys
GROQ_API_KEY=

# Optional. Groq model used by the agents (default: openai/gpt-oss-120b)
# GROQ_MODEL=openai/gpt-oss-120b

# Optional, for manual tests only. When GROQ_MODEL reaches its daily limit, the next model answers:
# by default Groq gpt-oss-20b, then Gemini, then a free OpenRouter model. The evaluations turn it off.
# The free Gemini and OpenRouter tiers may use the prompts to train their models: mock data only.
# LLM_FALLBACK=true
# FALLBACK_MODELS=groq:openai/gpt-oss-20b,gemini:gemini-3.5-flash,openrouter:nvidia/nemotron-3-super-120b-a12b:free
# Google AI Studio key, from https://aistudio.google.com/apikey (also used by the evaluation judge)
# GEMINI_API_KEY=
# OpenRouter key, from https://openrouter.ai/settings/keys
# OPENROUTER_API_KEY=

# Evaluation with RAGAS (requirements-eval.txt, see ragas_project.md)
# Do not send anonymous usage statistics to the RAGAS authors.
RAGAS_DO_NOT_TRACK=true
# Optional. The Groq model that judges the hypotheses (default: openai/gpt-oss-120b)
# RAGAS_JUDGE_MODEL=openai/gpt-oss-120b

# Optional. LangSmith tracing: every run of the graph is saved in smith.langchain.com
# (see langgraph_project.md). Without these lines nothing is sent and everything works the same.
# API key from https://smith.langchain.com, Settings > API Keys
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=rca-investigation
# Only for an account created in the EU region; without it the US server is used
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

JWT_SECRET=